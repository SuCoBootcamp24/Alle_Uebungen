DROP TABLE IF EXISTS Zugverbindung;
DROP TABLE IF EXISTS Zug;
DROP TABLE IF EXISTS Kategorie;


CREATE TABLE Kategorie (
    KategorieID INT PRIMARY KEY,
    Name VARCHAR(50)
);

CREATE TABLE Zug (
    ZugID INT PRIMARY KEY,
    KategorieID INT,
    Sitzplaetze INT,
    Stehplaetze INT,
    FOREIGN KEY (KategorieID) REFERENCES Kategorie(KategorieID)
);

CREATE TABLE Zugverbindung (
    VerbindungID INT PRIMARY KEY,
    ZugID INT,
    Startort VARCHAR(50),
    Ankunftsort VARCHAR(50),
    Datum DATE,
    Dauer TIME,
    FOREIGN KEY (ZugID) REFERENCES Zug(ZugID)
);


