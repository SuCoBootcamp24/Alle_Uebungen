DROP TABLE IF EXISTS MOVIES;
DROP TABLE IF EXISTS DIRECTORS;


CREATE TABLE DIRECTORS (
    ID INT PRIMARY KEY,
    NAME VARCHAR(50)
);

CREATE TABLE MOVIES (
    ID INT PRIMARY KEY,
    TITLE VARCHAR(50),
    GENRE VARCHAR(20),
    RELEASE_YEAR INT,
    DIRECTORS_ID INT,
    FOREIGN KEY (DIRECTORS_ID) REFERENCES DIRECTORS(ID)
);

