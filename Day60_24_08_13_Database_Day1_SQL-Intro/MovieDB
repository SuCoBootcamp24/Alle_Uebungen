SELECT *
FROM MOVIES;

SELECT *
FROM MOVIES
WHERE GENRE = 'Sci-Fi';

SELECT *
FROM MOVIES
WHERE RELEASE_YEAR > 1995;

SELECT *
FROM DIRECTORS;

/* Zeige die Anzahl der Filme pro Genre an*/
SELECT GENRE, COUNT(*) AS NUMBERS_OF_MOVIES
FROM MOVIES
GROUP BY GENRE;

/* Berechne das durchschnittliche Erscheinungsjahr für Filme in jedem Genre*/
SELECT AVG(RELEASE_YEAR)
FROM MOVIES
GROUP BY GENRE;

/* Zeige die Top 5 Genres mit den meisten Filmen an*/
SELECT TOP 5(GENRE)
FROM MOVIES;

/* Besser = */
SELECT GENRE, COUNT(*) AS NUMBERS_OF_MOVIES
FROM MOVIES
GROUP BY GENRE
ORDER BY NUMBERS_OF_MOVIES DESC
LIMIT 5;

/* Finde das Erscheinungsjahr mit den meisten veröffentlichten Filmen*/
SELECT RELEASE_YEAR
FROM MOVIES
GROUP BY RELEASE_YEAR
ORDER BY COUNT(*) DESC
LIMIT 1;

/* Zeige die Genres mit den meisten Filmen, die nach dem Jahr 2000 veröffentlicht wurden*/
SELECT GENRE, COUNT(*) AS NUMBERS_OF_MOVIES
FROM MOVIES
WHERE RELEASE_YEAR > 2000
GROUP BY GENRE
ORDER BY NUMBERS_OF_MOVIES DESC;

/* Sortiere die Genres nach der Anzahl der darin enthaltenen Filme, absteigend*/
SELECT GENRE, COUNT(*) AS NUMBERS_OF_MOVIES
FROM MOVIES
GROUP BY GENRE
ORDER BY NUMBERS_OF_MOVIES DESC;

/* Finde das Genre, dessen Filme im Durchschnitt am ältesten sind */
SELECT GENRE, AVG(RELEASE_YEAR) AS AVG_RELEASE_YEAR
FROM MOVIES
GROUP BY GENRE
ORDER BY AVG_RELEASE_YEAR
LIMIT 1;

SELECT GENRE
FROM MOVIES
GROUP BY GENRE
ORDER BY AVG(RELEASE_YEAR)
LIMIT 1;
