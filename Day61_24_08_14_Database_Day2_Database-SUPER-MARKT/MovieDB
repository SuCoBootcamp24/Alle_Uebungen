/* Zeige alle Produkte an*/
SELECT * FROM PRODUCTS;
SELECT * FROM CATEGORIES;

/* Zeige alle Produkte einer bestimmten Kategorie an (z.B. Obst)*/
SELECT *
FROM PRODUCTS
WHERE CATEGORIES_ID = 7;

/* Zeige alle Produkte an, die teurer als 5 Euro sind*/
SELECT *
FROM PRODUCTS
WHERE PRICE > 5.0;

/* Zeige alle Produkte an, deren Verfallsdatum abgelaufen ist*/
SELECT *
FROM PRODUCTS
WHERE EXPIRY_DATE < CURDATE();

/* Produkte, die innerhalb der nächsten 7 Tage ablaufen*/
SELECT *
FROM PRODUCTS
WHERE EXPIRY_DATE BETWEEN CURDATE() AND DATEADD('DAY', 7, CURDATE());

/* Produkte gruppieren nach Kategorie*/
SELECT *
FROM PRODUCTS
ORDER BY CATEGORIES_ID;

/* Durchschnittlicher Preis pro Kategorie*/
SELECT CATEGORIES_ID , ROUND(AVG(CAST(PRICE AS FLOAT)),2) AS AVG_PRICE
FROM PRODUCTS
GROUP BY CATEGORIES_ID
ORDER BY AVG_PRICE;

/*Top 3 Kategorien nach Anzahl der Produkte*/
SELECT CATEGORIES_ID, COUNT(*) AS PRODUCTS_IN_CAT
FROM PRODUCTS
GROUP BY CATEGORIES_ID
ORDER BY PRODUCTS_IN_CAT DESC
LIMIT 3;

/*Kategorie mit dem höchsten durchschnittlichen Preis*/
SELECT CATEGORIES_ID , ROUND(AVG(CAST(PRICE AS FLOAT)),2) AS AVG_PRICE
FROM PRODUCTS
GROUP BY CATEGORIES_ID
ORDER BY AVG_PRICE DESC;
LIMIT 1;

/*Kategorien mit den meisten abgelaufenen Produkten*/
SELECT CATEGORIES_ID
FROM PRODUCTS
WHERE EXPIRY_DATE < CURDATE()
GROUP BY CATEGORIES_ID
ORDER BY COUNT(*) DESC
LIMIT 1;

/*Produkte mit der höchsten Haltbarkeit in ihrer Kategorie*/
SELECT *
FROM PRODUCTS
WHERE EXPIRY_DATE IS NOT NULL
ORDER BY DATEDIFF('DAY', CURDATE(), EXPIRY_DATE) DESC
LIMIT 1;
/* ODER*/
SELECT P1.*
FROM PRODUCTS P1
WHERE P1.EXPIRY_DATE = (
    SELECT MAX(P2.EXPIRY_DATE)
    FROM PRODUCTS P2
    WHERE P2.CATEGORIES_ID = P1.CATEGORIES_ID
)
ORDER BY P1.CATEGORIES_ID;

/* Durchschnittliche Haltbarkeit (Tage) pro Kategorie*/
SELECT CATEGORIES_ID, ROUND(AVG(CAST(DATEDIFF('DAY', CURDATE(), EXPIRY_DATE) AS FLOAT)),1) AS AVG_EXPIRY_DAYS
FROM PRODUCTS
WHERE EXPIRY_DATE >= CURDATE()
GROUP BY CATEGORIES_ID
ORDER BY AVG_EXPIRY_DAYS DESC;

/*Durchschnittlicher Preis für Produkte, die nach 2023 ablaufen*/
SELECT *
FROM PRODUCTS
WHERE EXPIRY_DATE >= '2023-12-31'
ORDER BY EXPIRY_DATE DESC;

/*Produkte mit Preis über dem Durchschnitt, sortiert nach Haltbarkeit*/
WITH AVG_PRICE AS (
    SELECT ROUND(AVG(CAST(PRICE AS FLOAT)),2) AS AVG_PRICE
    FROM PRODUCTS
)
SELECT *
FROM PRODUCTS
WHERE PRICE > (SELECT AVG_PRICE FROM AVG_PRICE)
ORDER BY EXPIRY_DATE DESC;

/*Teuerstes Produkt in jeder Kategorie finden*/
SELECT NAME,
      (SELECT p.NAME
       FROM PRODUCTS p
       WHERE p.PRICE = (SELECT MAX(p2.PRICE)
                        FROM PRODUCTS p2
                        WHERE c.ID = p2.CATEGORIES_ID
                        )
       LIMIT 1) AS MOST_EXPENSIVE_PRODUCT,
FROM CATEGORIES c;

/*Produkte anzeigen, deren Preis über dem Durchschnittspreis aller Produkte liegt*/
SELECT *
FROM PRODUCTS
WHERE PRICE > (SELECT AVG(PRICE)
               FROM PRODUCTS
              );