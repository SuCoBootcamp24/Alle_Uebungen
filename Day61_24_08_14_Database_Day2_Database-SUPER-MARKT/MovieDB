DROP TABLE IF EXISTS PRODUCTS;
DROP TABLE IF EXISTS CATEGORIES;


CREATE TABLE CATEGORIES (
    ID INT PRIMARY KEY,
    NAME VARCHAR(50)
);

CREATE TABLE PRODUCTS (
    ID INT PRIMARY KEY,
    CATEGORIES_ID INT,
    NAME VARCHAR(50),
    PRICE FLOAT,
    EXPIRY_DATE DATE,
    FOREIGN KEY (CATEGORIES_ID) REFERENCES CATEGORIES(ID)
);



