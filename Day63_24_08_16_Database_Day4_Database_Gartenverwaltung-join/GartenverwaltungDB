/*Berechne die gesamte Anzahl von Pflanzen in jedem Garten*/
SELECT NAME AS GARTEN_NAME, (SELECT SUM(ANZAHL)
              FROM GARTENPFLANZEN
              WHERE GARTEN.GARTENID = GARTENPFLANZEN.GARTENID
              ) AS PFLANZEN_ANZAHL
FROM GARTEN;

/*Finde die Namen der Pflanzen und die Anzahl der Pflanzen im „Blumenparadies“*/

SELECT
    g.NAME AS GARTEN_NAME,

    (SELECT p.NAME
     FROM PFLANZE p
     WHERE p.PFLANZENID = gp.PFLANZENID) AS PFLANZEN_NAME,

    gp.ANZAHL AS ANZAHL

FROM GARTENPFLANZEN gp
INNER JOIN GARTEN g ON gp.GARTENID = g.GARTENID
WHERE g.NAME = 'Blumenparadies';

-- ODER
SELECT
    g.NAME AS GARTEN_NAME,
    p.NAME AS PFLANZEN_NAME,
    gp.ANZAHL AS ANZAHL
FROM GARTENPFLANZEN gp
INNER JOIN GARTEN g ON gp.GARTENID = g.GARTENID
INNER JOIN PFLANZE p ON gp.PFLANZENID = p.PFLANZENID
WHERE g.NAME = 'Blumenparadies';

/* Liste Gärten mit weniger als 200 Pflanzen auf*/
SELECT
    g.NAME AS GARTEN_NAME,
    SUM(gp.ANZAHL) AS PFLANZEN_ANZAHL
FROM
    GARTEN g
LEFT JOIN
    GARTENPFLANZEN gp ON g.GARTENID = gp.GARTENID
GROUP BY
    g.NAME
HAVING
    SUM(gp.ANZAHL) < 200;

/*Finde den Namen der Pflanze und den Wasserbedarf für alle essbaren Pflanzen im „Kräutergarten“*/
SELECT
    p.NAME AS PFLANZEN_NAME,
    SUM(p.WASSERBEDARFPROPFLANZE * gp.ANZAHL) AS WASSERBEDARF_IN_L
FROM GARTENPFLANZEN gp
INNER JOIN GARTEN g ON gp.GARTENID = g.GARTENID
INNER JOIN PFLANZE p ON gp.PFLANZENID = p.PFLANZENID
WHERE g.NAME = 'Kräutergarten'
AND p.ESSBAR = TRUE
GROUP BY p.NAME;